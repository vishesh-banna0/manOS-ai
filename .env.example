DATABASE_URL="DATABASE_URL"

# LLM provider: openrouter (hosted) or ollama (local)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# See backend/.env.example for the full set of tuning knobs.
# Optional for hosted models with sufficient rate limits:
# AGENT_TOPIC_CONCURRENCY=2
