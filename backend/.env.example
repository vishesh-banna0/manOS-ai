# ---- Database ----
DATABASE_URL=postgresql+pg8000://postgres:1234@localhost:5432/manos_ai

# ---- LLM provider ----
# "openrouter" (hosted) or "ollama" (local). Agents are provider-agnostic.
LLM_PROVIDER=openrouter

# Retry a transient failure (429 / 5xx / timeout) on this provider.
# Empty = disabled. Set to "ollama" to fall back to local models.
LLM_FALLBACK_PROVIDER=

# ---- OpenRouter ----
# Secret - keep it in .env, never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_URL=https://openrouter.ai/api/v1

# One model serves every agent. Override only if you want a stronger critic
# than the author - a weak critic rubber-stamps its own output, which the
# evaluation harness reports as the "critic vs judge gap".
# OPENROUTER_CRITIC_MODEL=

# ---- Ollama ----
# Required even when LLM_PROVIDER=openrouter: embeddings have no OpenRouter
# equivalent, so ingestion and semantic dedupe always use Ollama.
OLLAMA_URL=http://localhost:11434

# Generation / critic models used when LLM_PROVIDER=ollama.
LLM_MODEL=llama3:8b
CRITIC_MODEL=qwen2.5:7b

# Embedding model. Must match EMBED_DIM (nomic-embed-text = 768).
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Inputs per /api/embed request. Batching is what keeps ingestion at seconds
# rather than minutes.
EMBED_BATCH_SIZE=64

LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
# Exponential backoff between retries of transient failures, in seconds.
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_MAX=30.0
LLM_TEMPERATURE=0.2
EMBED_TIMEOUT=60

# ---- Uploads ----
# Textbook PDFs routinely run 30-80 MB.
MAX_UPLOAD_MB=100

# ---- Semantic chunking ----
CHUNK_TARGET_WORDS=320
CHUNK_MAX_WORDS=500
CHUNK_MIN_WORDS=60
CHUNK_BREAKPOINT_PERCENTILE=82

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_MMR_LAMBDA=0.6
HYBRID_KEYWORD_WEIGHT=0.25

# ---- Agent budgets ----
AGENT_MAX_TOPICS=12
# Optional concurrent topics (1-4). Default: 1 for free OpenRouter tiers,
# 2 for other hosted models. Ollama/local fallback always stays sequential.
# AGENT_TOPIC_CONCURRENCY=2
AGENT_CARDS_PER_TOPIC=3
AGENT_MAX_REPAIR_ROUNDS=2
AGENT_DUPLICATE_THRESHOLD=0.88
