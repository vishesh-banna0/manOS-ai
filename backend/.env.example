# ---- Database ----
DATABASE_URL=postgresql+pg8000://postgres:1234@localhost:5432/manos_ai

# ---- Ollama ----
OLLAMA_URL=http://localhost:11434

# Generation model used by the authoring / planning / recommendation agents.
LLM_MODEL=llama3:8b

# Critic model for the authoring loop's accept/revise/reject gate.
# Keep this at least as strong as LLM_MODEL - the evaluation harness reports a
# "critic vs judge gap", and a weak critic rubber-stamps its own output.
CRITIC_MODEL=qwen2.5:7b

# Embedding model. Must match EMBED_DIM (nomic-embed-text = 768).
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Inputs per /api/embed request. Batching is what keeps ingestion at seconds
# rather than minutes.
EMBED_BATCH_SIZE=64

LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
EMBED_TIMEOUT=60

# ---- Uploads ----
# Textbook PDFs routinely run 30-80 MB.
MAX_UPLOAD_MB=100

# ---- Semantic chunking ----
CHUNK_TARGET_WORDS=320
CHUNK_MAX_WORDS=500
CHUNK_MIN_WORDS=60
CHUNK_BREAKPOINT_PERCENTILE=82

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_MMR_LAMBDA=0.6
HYBRID_KEYWORD_WEIGHT=0.25

# ---- Agent budgets ----
AGENT_MAX_TOPICS=12
AGENT_CARDS_PER_TOPIC=3
AGENT_MAX_REPAIR_ROUNDS=2
AGENT_DUPLICATE_THRESHOLD=0.88
